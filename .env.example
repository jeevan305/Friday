# ── LLM ──────────────────────────────────────────────────────────────────────
# Required: Google Gemini API key

# Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ── Agent loop ────────────────────────────────────────────────────────────────
# Maximum investigation iterations before stopping (default: 30)
MAX_ITERATIONS=30

# ── Repository scanning ───────────────────────────────────────────────────────
# Maximum file size to read in bytes (default: 524288 = 512 KB)
MAX_FILE_SIZE_BYTES=524288

# Maximum lines returned per read_file call (default: 300)
MAX_READ_LINES=300

# ── LLM retry ────────────────────────────────────────────────────────────────
# Number of retries on rate-limit errors (default: 5)
LLM_MAX_RETRIES=5

# Initial wait time in seconds before first retry (doubles each attempt)
LLM_RETRY_INITIAL_WAIT=2.0

# ── Observability ─────────────────────────────────────────────────────────────
# Directory where investigation run JSON files are saved (default: runs/)
RUNS_DIR=runs

# ── FastAPI (optional) ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Optional Gemini thinking level: minimal | low | medium | high (empty = model default)
GEMINI_THINKING_LEVEL=
